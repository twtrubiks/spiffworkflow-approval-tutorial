<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- ===== 流程邏輯：SpiffWorkflow 只讀這一段 ===== -->
  <bpmn:process id="purchase_approval" name="請購簽核" isExecutable="true">
    <bpmn:startEvent id="start" name="送出申請">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="manager_approve" name="直屬主管審核">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="amount_gateway" name="金額判斷" default="flow_small">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_big</bpmn:outgoing>
      <bpmn:outgoing>flow_small</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="cfo_approve" name="財務長審核">
      <bpmn:incoming>flow_big</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:scriptTask id="write_back" name="回寫單據狀態">
      <bpmn:incoming>flow_small</bpmn:incoming>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:script>approval_result = 'approved'</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="end" name="結案">
      <bpmn:incoming>flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="manager_approve" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="manager_approve" targetRef="amount_gateway" />
    <bpmn:sequenceFlow id="flow_big" name="金額 &gt; 10000" sourceRef="amount_gateway" targetRef="cfo_approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">self.amount_total &gt; 10000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_small" name="其他（預設）" sourceRef="amount_gateway" targetRef="write_back" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="cfo_approve" targetRef="write_back" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="write_back" targetRef="end" />
  </bpmn:process>

  <!-- ===== 圖面座標：只給畫圖工具（bpmn-js 等）用，SpiffWorkflow 會忽略 ===== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="purchase_approval">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="146" y="225" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manager_approve_di" bpmnElement="manager_approve">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="amount_gateway_di" bpmnElement="amount_gateway" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="396" y="232" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cfo_approve_di" bpmnElement="cfo_approve">
        <dc:Bounds x="500" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="write_back_di" bpmnElement="write_back">
        <dc:Bounds x="640" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="802" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="808" y="225" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="395" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_big_di" bpmnElement="flow_big">
        <di:waypoint x="420" y="175" />
        <di:waypoint x="420" y="80" />
        <di:waypoint x="500" y="80" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="120" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_small_di" bpmnElement="flow_small">
        <di:waypoint x="445" y="200" />
        <di:waypoint x="640" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="180" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="600" y="80" />
        <di:waypoint x="690" y="80" />
        <di:waypoint x="690" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="740" y="200" />
        <di:waypoint x="802" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
